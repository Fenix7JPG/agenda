# ──────────────────────────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores.
# La app funciona sin tocar nada: usa SQLite local en data/.
# ──────────────────────────────────────────────────────────────

# Contraseña para entrar a la aplicación (cámbiala)
APP_PASSWORD=cambiar-esta-contrasena

# Clave para firmar la cookie de sesión (opcional: si se omite,
# se genera y guarda automáticamente en data/secret.key)
# SECRET_KEY=

# Modo de base de datos: "local" (SQLite) o "turso"
# Si se deja vacío, se detecta solo: Turso si hay TURSO_URL, si no local.
DB_MODE=local

# Ruta de la base SQLite local
DB_PATH=data/app.db

# ── Turso (solo si DB_MODE=turso o TURSO_URL está presente) ──
# TURSO_URL=libsql://[tu-base]-[tu-usuario].turso.io
# TURSO_AUTH_TOKEN=

# Días que el planificador mira hacia adelante (opcional, default 7)
# HORIZONTE_DIAS=7
